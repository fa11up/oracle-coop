pragma solidity 0.8.26;

import {Test} from "forge-std/Test.sol";
import {OracleCoopHub} from "../src/OracleCoopHub.sol";

/// @notice Replays a REAL attestation signed by the production service key, so the hub's struct hash,
/// domain, question splice and signer constant are proven against the live service and not only
/// against a test key.
/// @dev Oracle request e2c85027 (2026-10-04) was bought for launch 688's PriceFeed on Sepolia, so its
/// EIP-712 domain names that address and chain. The hub is deployed AT that address on that chain id,
/// which is the only way to verify the original signature. The question prefix is PriceFeed's pinned
/// QUESTION_PREFIX from github.com/fa11up/infer-protocol, generated by oracle/question-prefix.mjs.
contract LiveAttestationTest is Test {
    address constant LIVE_CONSUMER = 0x5bbFA44200AcE481388B0B69355F7Bd1FeAb0462;
    uint256 constant SEPOLIA = 11155111;

    bytes constant PRICE_PREFIX =
        hex"";

    bytes constant SIG =
        hex"8303bd1ea1bc22a4f4b32ac95dedb591d0facdc07e23fdbbe2ef3da4194bf8cf7d94b98d49ffe924b326b6980811fdb403a8ee7ca766ff9bd24cbfe8d8b85da21c";

    function _question() internal pure returns (OracleCoopHub.Question memory) {
        return OracleCoopHub.Question({
            prefix: PRICE_PREFIX,
            dataChainId: 1,
            answerType: 3,
            minSpan: 300,
            maxSpan: 1200,
            minPanel: 25,
            minAgreed: 15,
            bountyWei: 0,
            paidInterval: 0
        });
    }

    function _attestation() internal pure returns (OracleCoopHub.Attestation memory) {
        return OracleCoopHub.Attestation({
            requestId: 0xe2c85027f00e4b988d7c713694509b6e00000000000000000000000000000000,
            chainId: 1,
            questionHash: 0xc87aa8a9fa49ca4885e3c3048e9159cd00578e7ad37188b1fce70199c510c16e,
            answerType: 3,
            answer: hex"000000000000000000000000000000000000000000000000000d3ff87714bef1",
            figure: 3729511079526129,
            fromBlock: 26120928,
            toBlock: 26121526,
            blockHash: 0x661f90063244eaa60ab43a4b65a46dd1a58b2a6e03526f0f4c80c1ca04988429,
            panelJobId: 0x85d6177a7f9b4b938c1a76fc35f733b500000000000000000000000000000000,
            panelSize: 60,
            quorum: 20,
            agreed: 20,
            issuedAt: 1791147640,
            expiresAt: 1791234040
        });
    }

    function _hubAt(address where) internal returns (OracleCoopHub hub) {
        vm.chainId(SEPOLIA);
        deployCodeTo("OracleCoopHub.sol:OracleCoopHub", where);
        hub = OracleCoopHub(where);
    }

    function test_LiveServiceSignatureIsAccepted() public {
        OracleCoopHub hub = _hubAt(LIVE_CONSUMER);
        bytes32 id = hub.register(_question());
        OracleCoopHub.Attestation memory a = _attestation();

        assertEq(hub.expectedQuestionHash(id, a.fromBlock, a.toBlock), a.questionHash, "splice reproduces live hash");

        vm.warp(a.issuedAt + 60);
        hub.submit(id, a, SIG, address(0));

        (uint256 figure, uint64 issuedAt, uint64 sequence) = hub.checked(id, 1 hours, 15);
        assertEq(figure, 3729511079526129);
        assertEq(issuedAt, a.issuedAt);
        assertEq(sequence, 1);
    }

    /// @notice The live panel signed agreed == quorum == 20 of 60. A ratio floor of 80% could never be
    /// met by such an answer; the count floor of 15 is.
    function test_LiveAgreementEqualsQuorum() public pure {
        OracleCoopHub.Attestation memory a = _attestation();
        assertEq(a.agreed, a.quorum);
        assertLt(uint256(a.agreed) * 10_000 / a.panelSize, 8_000);
    }

    /// @notice The same genuine signature is worthless to a hub at any other address.
    function test_LiveSignatureIsBoundToItsConsumer() public {
        OracleCoopHub hub = _hubAt(address(0xC0FFEE));
        bytes32 id = hub.register(_question());
        OracleCoopHub.Attestation memory a = _attestation();
        vm.warp(a.issuedAt + 60);
        vm.expectRevert(OracleCoopHub.InvalidSignature.selector);
        hub.submit(id, a, SIG, address(0));
    }

    /// @notice A genuine signature for this hub does not answer a different question registered here.
    function test_LiveSignatureDoesNotAnswerAnotherQuestion() public {
        OracleCoopHub hub = _hubAt(LIVE_CONSUMER);
        OracleCoopHub.Question memory other = _question();
        other.minSpan = 299; // same document, different question id
        bytes32 id = hub.register(other);
        OracleCoopHub.Question memory different = _question();
        different.prefix = bytes.concat(hex"20", PRICE_PREFIX); // a different document
        bytes32 wrongId = hub.register(different);
        OracleCoopHub.Attestation memory a = _attestation();
        vm.warp(a.issuedAt + 60);
        vm.expectRevert();
        hub.submit(wrongId, a, SIG, address(0));
        hub.submit(id, a, SIG, address(0)); // the matching document still accepts it
    }
}
